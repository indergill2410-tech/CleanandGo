# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your_supabase_project_ref
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@cleanngo.com.au
ADMIN_EMAIL=indergill2410@gmail.com,fizaadrees879@gmail.com

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Stripe product ids for recurring plans (create once per Stripe account)
STRIPE_PRODUCT_HOME=prod_xxxxxxxxxxxxxx
STRIPE_PRODUCT_OFFICE=prod_xxxxxxxxxxxxxx

# Payroll cron (shared secret the Render Cron Job sends as a Bearer token)
CRON_SECRET=generate_a_long_random_string

# Address autocomplete (Mapbox). Optional — address fields work without it.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# App
NEXT_PUBLIC_APP_URL=https://cleanngo.com.au
NEXT_PUBLIC_APP_NAME=Clean&Go
NEXT_PUBLIC_BUSINESS_REGION=Australia
